# Adyen (test) credentials — Customer Area > Developers > API credentials
ADYEN_API_KEY=
ADYEN_CLIENT_KEY=
ADYEN_MERCHANT_ACCOUNT=
# HMAC key from your Standard webhook (leave empty to skip signature checks locally)
ADYEN_HMAC_KEY=
ADYEN_ENVIRONMENT=TEST
# Only needed when ADYEN_ENVIRONMENT=LIVE
ADYEN_LIVE_PREFIX=
# Base URL the /forward API calls for Recurring/v30/storeToken
ADYEN_FORWARD_BASE_URL=https://pal-test.adyen.com
# Base URL the /forward API calls for the $0 auth on a member token (/checkout/v71/payments)
ADYEN_CHECKOUT_FORWARD_BASE_URL=https://checkout-test.adyen.com
# Log every Adyen API request/response to the console (set to false to silence)
ADYEN_DEBUG=true

# Public URL of this app (used for the Adyen returnUrl)
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me
